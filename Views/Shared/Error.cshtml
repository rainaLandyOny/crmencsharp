@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="container mt-5">
    <div class="alert alert-danger">
        <h1 class="alert-heading">Une erreur est survenue</h1>
        
        @if (Model?.StatusCode != null)
        {
            <h2>Erreur @Model.StatusCode</h2>
        }

        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
        {
            <p class="mb-0">@Model.ErrorMessage</p>
        }
        else
        {
            <p class="mb-0">Une erreur inattendue s'est produite. Notre équipe technique a été notifiée.</p>
        }

        @if (Model?.ShowRequestId == true)
        {
            <hr>
            <p class="mb-0 small text-muted">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }
    </div>

    <div class="text-center mt-4">
        <a href="/" class="btn btn-primary">
            <i class="fas fa-home"></i> Retour à l'accueil
        </a>
    </div>
</div>

<style>
    .container {
        max-width: 800px;
    }
    .alert {
        border-left: 5px solid #dc3545;
    }
</style>
